rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidPayloadSize() {
      return request.resource == null || request.resource.data.keys().size() <= 50;
    }

    // User profile isolation
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidPayloadSize();
      allow delete: if isOwner(userId);

      // Event collections and subcollections isolated to the authenticated owner
      match /events/{eventId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidPayloadSize();
        allow delete: if isOwner(userId);

        match /tasks/{taskId} {
          allow read: if isOwner(userId);
          allow create, update: if isOwner(userId) && isValidPayloadSize();
          allow delete: if isOwner(userId);
        }

        match /expenses/{expenseId} {
          allow read: if isOwner(userId);
          allow create, update: if isOwner(userId) && isValidPayloadSize();
          allow delete: if isOwner(userId);
        }

        match /vendors/{vendorId} {
          allow read: if isOwner(userId);
          allow create, update: if isOwner(userId) && isValidPayloadSize();
          allow delete: if isOwner(userId);
        }

        match /guests/{guestId} {
          allow read: if isOwner(userId);
          allow create, update: if isOwner(userId) && isValidPayloadSize();
          allow delete: if isOwner(userId);
        }
      }
    }

    // Explicit default deny for all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
